import time
import sys

def typing_effect(text, speed=0.015):
    """কনসোলে কোনো লেখা টাইপরাইটারের মতো দেখানোর জন্য প্রফেশনাল ফাংশন"""
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(speed)
    print()

